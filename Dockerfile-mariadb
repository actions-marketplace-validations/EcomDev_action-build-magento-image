# check=skip=SecretsUsedInArgOrEnv
ARG SOURCE_VERSION=11.8

FROM ghcr.io/wardenenv/mariadb:${SOURCE_VERSION} AS mariadb-rootfs

COPY --from=scripts --chmod=0755 write-db-config.sh prepare-db-rootfs.sh /tmp/
RUN ["/tmp/prepare-db-rootfs.sh", "mariadb"]

FROM --platform=$BUILDPLATFORM ghcr.io/wardenenv/mariadb:${SOURCE_VERSION} AS mariadb-init

COPY --from=scripts --chmod=0755 write-db-config.sh init-db.sh /tmp/
COPY *.sql* /docker-entrypoint-initdb.d/

RUN ["/tmp/init-db.sh", "mariadb"]

FROM scratch

ENV PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    MYSQL_DATABASE=magento \
    MYSQL_PASSWORD=magento \
    MYSQL_ROOT_PASSWORD=magento \
    MYSQL_USER=magento

COPY --from=mariadb-rootfs /rootfs /
COPY --from=scripts --chmod=0755 db-entrypoint.sh /usr/local/bin/db-entrypoint.sh
COPY --from=mariadb-init --chown=mysql:mysql /setup/db /var/lib/mysql

USER mysql
EXPOSE 3306

ENTRYPOINT ["/usr/local/bin/db-entrypoint.sh", "mariadbd"]